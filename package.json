{
  "name": "@morehao/dsh-kindle-shelf",
  "version": "0.1.0",
  "description": "Kindle 书库工作台的 DeepSeek Harness 插件：本机电子书扫描、EPUB 转 AZW3/MOBI、局域网推送到 Kindle（浏览器下载），越狱设备可 SFTP 双向管理。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kindle",
    "ebook",
    "epub",
    "azw3",
    "calibre"
  ],
  "engines": {
    "node": "^22.20.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0 || >=0.2.2-alpha.0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0 || >=0.2.2-alpha.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@morehao/dsh-plugin-kit": "^0.5.1",
    "fflate": "^0.8.3",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/ssh2": "^1.15.1",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:host": "tsup",
    "build:client": "node scripts/build-client.mjs",
    "dev:client": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:types": "tsc -p tsconfig.client.json",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "author": "morehao <morehao@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morehao/dsh-kindle-shelf.git"
  },
  "bugs": "https://github.com/morehao/dsh-kindle-shelf/issues",
  "homepage": "https://github.com/morehao/dsh-kindle-shelf",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
